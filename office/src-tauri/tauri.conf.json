{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentUX Office",
  "mainBinaryName": "agentux-office",
  "version": "0.1.0",
  "identifier": "os.agentux.office",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Your organization's agents at work",
    "longDescription": "AgentUX Office for the desktop: the floor, missions and approvals of your organization on an AgentUX Command server.",
    "publisher": "AgentUX contributors",
    "homepage": "https://github.com/agentux-os/agentux-desktop",
    "license": "Apache-2.0",
    "linux": {
      "rpm": {
        "release": "1",
        "desktopTemplate": "linux/agentux-office.desktop"
      }
    }
  }
}
