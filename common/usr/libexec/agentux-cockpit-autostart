#!/bin/sh
# Login autostart for the AgentUX cockpit (Exec= of
# /etc/xdg/autostart/agentux-cockpit.desktop).
#
# XDG autostart can run for system accounts during first-boot setup. Skip
# those accounts here, using the same boundary as systemd's ConditionUser=!@system
# (UID below UID_MIN in /etc/login.defs, 1000 by default), on every desktop.
uid_min=$(sed -n 's/^[[:space:]]*UID_MIN[[:space:]]\{1,\}\([0-9]\{1,\}\).*/\1/p' /etc/login.defs 2>/dev/null | head -n 1)
case $uid_min in
    '' | *[!0-9]*) uid_min=1000 ;;
esac

uid=$(id -u)
if [ "$uid" -lt "$uid_min" ]; then
    echo "agentux-cockpit: not starting for system user $(id -un) (uid $uid < UID_MIN $uid_min)" >&2
    exit 0
fi

# After the desktop's own first-login setup (COSMIC Initial Setup), not on
# top of it.
if [ -x /usr/libexec/agentux-setup ]; then
    /usr/libexec/agentux-setup wait-desktop-setup
fi

exec agentux-cockpit "$@"
